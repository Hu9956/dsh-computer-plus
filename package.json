{
  "name": "@kewen/dsh-computer-plus",
  "version": "0.1.4",
  "private": true,
  "description": "电脑操控 Plus：给 Agent 一组 computer_* 工具（底层是 cua-driver），在对话信息面板里实时显示它正在操控的窗口。仅 macOS。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "meta": {
      "title": "电脑操控 Plus",
      "description": "给 Agent 一组 computer_* 工具（底层是 cua-driver），在对话信息面板里实时显示它正在操控的窗口。仅 macOS。"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  },
  "dsh-std": {
    "apiVersion": "dsh-std/v1",
    "domains": [
      "presentation",
      "tool"
    ],
    "platforms": [
      "web"
    ],
    "permissions": [],
    "applies": "restart"
  },
  "scripts": {
    "bundle": "node run.mjs bundle",
    "typecheck": "node run.mjs typecheck",
    "test": "node --import tsx --test tests/*.test.ts"
  },
  "files": [
    "lib/index.js",
    "lib/driver.js",
    "lib/projection.js",
    "lib/tools.js",
    "lib/client.js",
    "lib/client.js.map",
    "cordis.patch.yml",
    "assets/computer-stream.swift",
    "README.md"
  ],
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@types/node": "^22.15.30",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tsdown": "0.22.2",
    "tsx": "4.22.4",
    "typescript": "5.6.3"
  },
  "license": "MIT"
}
