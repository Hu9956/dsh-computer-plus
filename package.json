{
  "name": "@kewen/dsh-computer-plus",
  "version": "0.2.10",
  "repository": {
    "type": "git",
    "url": "https://github.com/Hu9956/dsh-computer-plus.git"
  },
  "homepage": "https://github.com/Hu9956/dsh-computer-plus#readme",
  "bugs": {
    "url": "https://github.com/Hu9956/dsh-computer-plus/issues"
  },
  "description": "让 Agent 在后台操控 macOS 桌面应用，不抢鼠标与窗口焦点；支持逐应用安全授权、前台借用胶囊提醒与一键引导配置（仅 macOS）。",
  "icon": "./icon.svg",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./icon": "./icon.svg"
  },
  "dsh": {
    "meta": {
      "title": "电脑操控 Plus",
      "description": "让 Agent 在后台操控 macOS 桌面应用，不抢鼠标与窗口焦点；支持逐应用安全授权、前台借用胶囊提醒与一键引导配置（仅 macOS）。"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  },
  "dsh-std": {
    "apiVersion": "dsh-std/v1",
    "domains": [
      "presentation",
      "tool"
    ],
    "platforms": [
      "web"
    ],
    "permissions": [],
    "applies": "restart"
  },
  "scripts": {
    "bundle": "node run.mjs bundle",
    "typecheck": "node run.mjs typecheck",
    "test": "node --import tsx --test tests/*.test.ts"
  },
  "files": [
    "lib/index.js",
    "lib/driver.js",
    "lib/projection.js",
    "lib/tools.js",
    "lib/access.js",
    "lib/setup.js",
    "lib/hud.js",
    "lib/client.js",
    "lib/client.js.map",
    "cordis.patch.yml",
    "assets/computer-stream",
    "assets/computer-stream.swift",
    "README.md",
    "icon.svg"
  ],
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@types/node": "^22.15.30",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tsdown": "0.22.2",
    "tsx": "4.22.4",
    "typescript": "5.6.3"
  },
  "license": "MIT"
}
